# Copy to .env and fill in with your real API keys.
# NEVER commit your real .env file to Git.

# Primary free image generator (Pollinations FLUX)
POLLINATIONS_API_KEY=your_pollinations_api_key_here

# Promotional trial image generator (Stability AI SDXL - 25 free credits)
STABILITY_API_KEY=your_stability_api_key_here

# Text & design analysis model (Gemini 2.5 Flash free tier)
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudflare Workers AI (10,000 neurons/day free - requires Workers AI token permission)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# Optional / secondary providers
HF_TOKEN=your_hf_token_here
FLUX_API_KEY=your_bfl_api_key_here

